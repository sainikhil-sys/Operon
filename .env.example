# ==============================================================================
# Operon App Environment Variables Template
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Application Configuration
# ------------------------------------------------------------------------------
# Base canonical URL of the application (default: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Supabase Configuration (Database & Authentication)
# ------------------------------------------------------------------------------
# Public Supabase project URL endpoint (e.g. https://your-project-id.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# Public Supabase anonymous client API key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Public Supabase publishable API key (alternative format)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Private Supabase service role key (used for server-side administrative tasks)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# Razorpay Payment Gateway Configuration
# ------------------------------------------------------------------------------
# Razorpay Key ID for client-side Checkout SDK
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
# Razorpay Key ID for server-side API requests
RAZORPAY_KEY_ID=rzp_test_your_key_id
# Razorpay Secret Key for verifying payment signatures
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Razorpay Webhook Secret for verifying incoming webhooks
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ------------------------------------------------------------------------------
# Groq AI Integration
# ------------------------------------------------------------------------------
# API Key for Groq Cloud (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key
